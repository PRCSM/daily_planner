# Cloud mirror (optional — the app is fully usable without it).
# Supabase → Project settings → API. The anon key is public by design; RLS protects rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# AI — pick ONE:
#  (a) CLOUD (default, safest): leave VITE_GROQ_API_KEY unset. The key lives only as an Edge Function secret:
#        supabase secrets set GROQ_API_KEY=...
#  (b) DIRECT (personal use only): set a FREE, rotatable key here, in the host's build env, never in source or git.
#      It is compiled into the site's JavaScript, so anyone who reads the bundle can use it. No sign-in or Supabase needed.
VITE_GROQ_API_KEY=
